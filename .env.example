# Django Secret Key
SECRET_KEY=django-insecure-avenor-dev-secret-key-change-in-production

# Debug Mode
DEBUG=True

# Database Configuration (PostgreSQL 17)
DB_NAME=avenor_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# JWT Configuration
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Allowed Hosts & CORS Origins
ALLOWED_HOSTS=localhost,127.0.0.1,api.avenor.local
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
